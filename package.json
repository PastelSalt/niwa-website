{
  "name": "niwa",
  "version": "1.0.0",
  "description": "NIWA — A garden for your ideas. Monorepo containing frontend (React/Vite) and backend (Node/Express) services.",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter frontend run dev",
    "build": "pnpm --filter frontend run build",
    "preview": "pnpm --filter frontend run preview",
    "lint": "pnpm --filter frontend run lint",
    "typecheck": "pnpm --filter frontend run typecheck",
    "test": "pnpm --filter frontend run test",
    "test:watch": "pnpm --filter frontend run test:watch",
    "e2e": "pnpm --filter frontend run e2e",
    "format": "pnpm --filter frontend run format"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
